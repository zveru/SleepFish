---
import "../styles/about.css";

import { Image } from "astro:assets";
import aboutBackground from "../images/00011.png";
import avatar from "../images/f0a1281ab4ff384e3005c66c0b3afa08f7badda0_raw.jpg";

// 占位：昵称、简介和仓库地址都在这里改
const profile = {
	nickname: "zre",
	handle: "zre",
	github: "#",
	bio: "这是一个部署在Cloudflare Pages上的个人博客网站，使用Astro框架开发",
};

// 借物表：填作者/出处，有链接就写 href，没有就留空
const credits: { label: string; source: string; href?: string }[] = [
	{ label: "背景插画", source: "@こうこうや pid：118616623" },
	{ label: "框架", source: "Astro" },
];
---

<article class="about" aria-labelledby="about-name">
	<div class="about__bg" aria-hidden="true">
		<Image
			src={aboutBackground}
			alt=""
			widths={[768, 1280, 1920]}
			sizes="100vw"
			format="webp"
			quality={70}
			loading="eager"
			fetchpriority="high"
		/>
	</div>

	<div class="about__inner">
		<figure class="about__portrait">
			<Image
				src={avatar}
				alt={`${profile.nickname} 的头像`}
				widths={[240, 360, 480]}
				sizes="(max-width: 700px) 38vw, 200px"
				format="webp"
				quality={82}
				loading="eager"
			/>
			<figcaption>@{profile.handle}</figcaption>
		</figure>

		<h1 id="about-name" class="about__name">{profile.nickname}</h1>

		<p class="about__bio">{profile.bio}</p>

		<ul class="about__links">
			<li>
				<a
					class="about__link"
					href={profile.github}
					target="_blank"
					rel="noreferrer noopener"
					data-placeholder={profile.github === "#" ? "" : undefined}
				>
					<span>GitHub 仓库</span>
					<svg class="about__link-icon" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
						<path
							d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4"
							fill="none"
							stroke="currentColor"
							stroke-width="1.3"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</a>
			</li>
		</ul>
	</div>

	<footer class="about__credits">
		<span class="about__credits-label">借物表</span>
		<ul class="about__credits-list">
			{
				credits.map(({ label, source, href }) => (
					<li>
						<span class="about__credits-item">{label}</span>
						{href ? (
							<a class="about__credits-source" href={href} target="_blank" rel="noreferrer noopener">
								{source}
							</a>
						) : (
							<span class="about__credits-source">{source}</span>
						)}
					</li>
				))
			}
		</ul>
	</footer>
</article>

<script>
	// 仓库地址还是占位，点下去不跳转；填上真实地址后这个标记会自动消失
	document.querySelectorAll<HTMLAnchorElement>(".about__link[data-placeholder]").forEach((link) => {
		link.addEventListener("click", (event) => event.preventDefault());
	});
</script>
