---
import "../styles/direction.css";

import { Image } from "astro:assets";
import directionBackground from "../images/00011.png";
---

<section id="direction" class="direction" data-snap-section>
	<div class="direction__media" aria-hidden="true">
		<Image
			src={directionBackground}
			alt=""
			widths={[640, 960, 1280]}
			sizes="100vw"
			format="webp"
			quality={78}
			loading="lazy"
		/>
	</div>

	<div class="direction__edge" aria-hidden="true">
		<svg viewBox="0 0 1440 96" preserveAspectRatio="none">
			<path d="M0 38C180 68 315 20 500 36s310 54 490 27 300-35 450-8v41H0z"></path>
			<path class="direction__edge-line" d="M0 38C180 68 315 20 500 36s310 54 490 27 300-35 450-8"></path>
		</svg>
	</div>
</section>
