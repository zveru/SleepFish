---
import "../styles/welcome.css";

import { Image } from "astro:assets";
import heroBackground from "../images/HThylrUaMAAeJ-n.jpg";

interface Props {
	name?: string;
	subtitle?: string;
}

const { name = "SleepFish", subtitle = "希望一天能睡26小时(´-ω-)"} = Astro.props;
---

<section class="welcome" data-welcome data-snap-section aria-labelledby="welcome-title">
	<div class="welcome__media" aria-hidden="true">
		<Image
			src={heroBackground}
			alt=""
			widths={[768, 1280, 1920]}
			sizes="100vw"
			format="webp"
			quality={78}
			loading="eager"
			fetchpriority="high"
		/>
	</div>

	<div class="welcome__content">
		<h1 id="welcome-title">{name}</h1>

		<p class="welcome__subtitle">
			<span class="sr-only">{subtitle}</span>
			<span data-typed-text={subtitle} aria-hidden="true"></span><span
				class="welcome__caret"
				aria-hidden="true"></span>
			<noscript>{subtitle}</noscript>
		</p>
	</div>

	<a class="welcome__scroll" href="#direction" aria-label="向下浏览">
		<svg
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M6 9l6 6 6-6"></path>
		</svg>
	</a>
</section>

<script>
	import { initHeroScroll } from "../scripts/hero-scroll";
	import { initTypewriter } from "../scripts/typewriter";

	initTypewriter();
	initHeroScroll();
</script>
